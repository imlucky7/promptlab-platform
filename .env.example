# =============================================================================
# Prompt Lab - Travel Planner backend configuration (sample)
#
# Copy this file to ``.env`` and adjust values for your environment:
#     cp .env.example .env
#
# All variables are read by ``app.core.config.Settings`` (pydantic-settings).
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Prompt Lab - Travel Planner API"
ENVIRONMENT=local                 # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# Comma separated list of allowed CORS origins (use * to allow all in dev).
CORS_ALLOW_ORIGINS=*

# ---- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=prompt_lab

# ---- LLM Gateway (LiteLLM or equivalent, OpenAI-compatible) ------------------
# When STUB_MODE is true (or the base URL/key are empty) the backend returns
# deterministic stub responses so it can run fully offline for local dev.
LLM_GATEWAY_STUB_MODE=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_SECONDS=60
LLM_GATEWAY_MAX_RETRIES=2

# ---- Token estimation --------------------------------------------------------
# Default estimation strategy: gateway | local
TOKEN_ESTIMATION_MODE=local
# Model name used when asking the gateway to estimate/return token usage.
TOKEN_ESTIMATION_MODEL=gpt-4o-mini
# tiktoken encoding/model used for the local approximation.
LOCAL_TOKENIZER_MODEL=gpt-4o-mini

# ---- Model catalogue (JSON) --------------------------------------------------
# Maps a logical model key to its provider/gateway identifiers. Override to add
# or remap models without code changes. Must be valid JSON on a single line.
MODEL_CATALOG='{"anthropic":{"providerModelName":"claude-3-5-sonnet-20240620","gatewayModelIdentifier":"anthropic/claude-3-5-sonnet-20240620","inputCostPer1k":0.003,"outputCostPer1k":0.015},"perplexity":{"providerModelName":"sonar-pro","gatewayModelIdentifier":"perplexity/sonar-pro","inputCostPer1k":0.003,"outputCostPer1k":0.015}}'

# ---- Seeding -----------------------------------------------------------------
# When true, the default "travel" use-case template is upserted on startup.
SEED_ON_STARTUP=true
