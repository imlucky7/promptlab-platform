# =============================================================================
# Prompt Lab - Travel Planner backend configuration (sample)
#
# Copy this file to ``.env`` and adjust values for your environment:
#     cp .env.example .env
#
# All variables are read by ``app.core.config.Settings`` (pydantic-settings).
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="Prompt Lab - Travel Planner API"
ENVIRONMENT=local                 # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# Comma separated list of allowed CORS origins (use * to allow all in dev).
CORS_ALLOW_ORIGINS=*

# ---- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=prompt_lab

# ---- LLM Gateway (LiteLLM or equivalent, OpenAI-compatible) ------------------
# When STUB_MODE is true the backend returns deterministic stub responses so it
# can run fully offline for local dev. Set it to false to call real providers.
# A model is only "live" when STUB_MODE=false AND a credential is available for
# it (either a direct provider key below, or the unified gateway URL+key); other-
# wise that model still returns a stub, so flipping this flag is always safe.
LLM_GATEWAY_STUB_MODE=true
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_SECONDS=60
LLM_GATEWAY_MAX_RETRIES=2

# ---- Direct provider API keys -----------------------------------------------
# Used when a model in MODEL_CATALOG declares a "provider" and you want to call
# that provider's OpenAI-compatible API directly (no separate gateway server).
#   - chatgpt -> OpenAI       (OPENAI_API_KEY,    https://platform.openai.com/api-keys)
#   - qwen3   -> Ollama (local, see OLLAMA_* settings below)
#   - perplexity -> Perplexity (PERPLEXITY_API_KEY)
# Paste your keys here and set LLM_GATEWAY_STUB_MODE=false to run for real.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# Override base URLs only if you use a proxy or a non-default region.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# ---- Ollama (local preview LLM via Qwen 3) -----------------------------------
# Preview uses POST /api/generate against a local Ollama instance.
# Set OLLAMA_PREVIEW_STUB_MODE=true to skip network calls (tests / offline).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_PREVIEW_STUB_MODE=false

# ---- Token estimation --------------------------------------------------------
# Default estimation strategy: gateway | local
TOKEN_ESTIMATION_MODE=local
# Model name used when asking the gateway to estimate/return token usage.
TOKEN_ESTIMATION_MODEL=gpt-4o-mini
# tiktoken encoding/model used for the local approximation.
LOCAL_TOKENIZER_MODEL=gpt-4o-mini

# ---- Model catalogue (JSON) --------------------------------------------------
# Maps a logical model key to its provider/gateway identifiers. The keys mirror
# the preview template model keys (chatgpt, qwen3) so a preview can be executed
# via /runs without remapping. Each entry's "provider" enables direct calls when
# the matching API key above is set. Must be valid JSON on a single line.
MODEL_CATALOG='{"chatgpt":{"provider":"openai","providerModelName":"gpt-4o","gatewayModelIdentifier":"openai/gpt-4o","inputCostPer1k":0.005,"outputCostPer1k":0.015},"qwen3":{"provider":"ollama","providerModelName":"qwen3:8b","gatewayModelIdentifier":"ollama/qwen3:8b","inputCostPer1k":0.0,"outputCostPer1k":0.0},"anthropic":{"provider":"anthropic","providerModelName":"claude-3-5-sonnet-20240620","gatewayModelIdentifier":"anthropic/claude-3-5-sonnet-20240620","inputCostPer1k":0.003,"outputCostPer1k":0.015},"perplexity":{"provider":"perplexity","providerModelName":"sonar-pro","gatewayModelIdentifier":"perplexity/sonar-pro","inputCostPer1k":0.003,"outputCostPer1k":0.015}}'

# ---- Seeding -----------------------------------------------------------------
# When true, the default "travel" use-case template is upserted on startup.
SEED_ON_STARTUP=true
